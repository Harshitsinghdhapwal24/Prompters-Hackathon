# Google Gemini API Configuration for LectureLens
# Get your API key at: https://aistudio.google.com/app/apikey

# Note: You can either set the key here or in the LectureLens web app UI (under Settings).
GEMINI_API_KEY=

# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
