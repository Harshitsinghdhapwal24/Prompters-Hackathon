# Google Gemini API Configuration for LectureLens (Primary Engine)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Supported Gemini models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (High-Speed Fallback Engine)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Supported Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
